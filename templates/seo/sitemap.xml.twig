<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url><loc>{{ url('app_home') }}</loc><priority>1.0</priority></url>
    <url><loc>{{ url('app_gallery_index') }}</loc><priority>0.9</priority></url>
{% for gallery in galleries %}
    <url><loc>{{ url('app_gallery_show', {slug: gallery.slug}) }}</loc><priority>0.8</priority></url>
{% endfor %}
    <url><loc>{{ url('app_about') }}</loc><priority>0.6</priority></url>
    <url><loc>{{ url('app_contact') }}</loc><priority>0.6</priority></url>
    <url><loc>{{ url('app_legal') }}</loc><priority>0.2</priority></url>
</urlset>
