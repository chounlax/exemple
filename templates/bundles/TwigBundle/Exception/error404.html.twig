            <p>
                <a class="button" href="{{ path('app_gallery_index') }}">Voir les galeries</a>
                <a class="button button--outline" href="{{ path('app_home') }}">Retour à l'accueil</a>
            </p>
        </div>
    </section>
{% endblock %}
